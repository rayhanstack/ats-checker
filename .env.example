# ==============================================================================
# ATS Checker - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your local or production environment:
#   cp .env.example .env
#   php artisan key:generate
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_NAME="ATS Checker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ------------------------------------------------------------------------------
# Logging & Error Tracking
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Optional Sentry DSN for production observability
# SENTRY_LARAVEL_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# Database Connection
# ------------------------------------------------------------------------------
# Default development uses MySQL. You can also switch DB_CONNECTION to sqlite for zero-config testing.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ats_checker
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------------------------
# Queue & Background Workers
# ------------------------------------------------------------------------------
# Resume AI parsing & scoring executes asynchronously via Laravel Queue.
# In local development and production, use 'database' or 'redis'. Run worker via:
#   php artisan queue:work --tries=4 --timeout=240
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Cache Store
# ------------------------------------------------------------------------------
# Used for caching FAQs, public active plans, testimonials, and dynamic settings.
CACHE_STORE=database
# CACHE_PREFIX=ats_checker_cache_

# ------------------------------------------------------------------------------
# Filesystem / Storage Disks
# ------------------------------------------------------------------------------
# Candidate resumes are stored privately on the local disk (storage/app/resumes)
# and NEVER made publicly accessible via URL.
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Mail Configuration (SMTP / Notifications)
# ------------------------------------------------------------------------------
# In local development, 'log' writes all outgoing emails to storage/logs/laravel.log.
# In production, configure your SMTP server or transactional provider (e.g., Postmark/SES/Resend).
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@atschecker.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Initial Super-Admin Credentials (Used by DatabaseSeeder)
# ------------------------------------------------------------------------------
# Initial credentials seeded when running: php artisan db:seed
ADMIN_EMAIL=admin@atschecker.local
ADMIN_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# AI Provider Credentials (Anthropic Claude Engine)
# ------------------------------------------------------------------------------
# Required for CV ATS matching, scoring, and recommendation generation.
# Obtain an API key from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Social Login / Google OAuth (Optional)
# ------------------------------------------------------------------------------
# Configure Google OAuth credentials to enable "Continue with Google" sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe / PayPal)
# ------------------------------------------------------------------------------
# The default active gateway is 'manual' (no live charges, admin activation).
# Configure keys below when enabling Stripe or PayPal integration.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------------------
# Vite Frontend Assets
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
